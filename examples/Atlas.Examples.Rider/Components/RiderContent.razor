@using Atlas.Blazor.Content

@if (Content.Reference.ResourceId == "project")
{
    <section class="rider-tool-content rider-project" aria-label="Project files">
        <div class="rider-tool-actions"><span>Atlas</span><button type="button" aria-label="Collapse all">⌃</button></div>
        <ul class="rider-tree">
            <li><span class="rider-chevron">⌄</span><strong>Atlas</strong></li>
            <li class="rider-tree-level-1"><span class="rider-chevron">⌄</span>examples</li>
            <li class="rider-tree-level-2"><span class="rider-chevron">⌄</span>Atlas.Examples.Rider</li>
            <li class="rider-tree-level-3 rider-file rider-file-active">▰ RiderWorkspace.razor</li>
            <li class="rider-tree-level-3 rider-file">♯ Program.cs</li>
            <li class="rider-tree-level-3 rider-file">◇ app.css</li>
            <li class="rider-tree-level-1"><span class="rider-chevron">›</span>src</li>
            <li class="rider-tree-level-1"><span class="rider-chevron">›</span>tests</li>
        </ul>
    </section>
}
else if (Content.Reference.ResourceId == "services")
{
    <section class="rider-tool-content rider-services" aria-label="Services">
        <div class="rider-service"><span class="rider-service-dot rider-service-running"></span><div><strong>Atlas.Examples.Rider</strong><small>Running on localhost</small></div></div>
        <div class="rider-service"><span class="rider-service-dot"></span><div><strong>Docker</strong><small>Not connected</small></div></div>
        <div class="rider-service"><span class="rider-service-dot rider-service-running"></span><div><strong>npm: build:js</strong><small>Completed</small></div></div>
    </section>
}
else if (Content.Reference.ResourceId == "terminal")
{
    <section class="rider-terminal" aria-label="Terminal output">
        <div><span class="rider-prompt">PS</span> C:\source\Atlas&gt; dotnet run --project examples/Atlas.Examples.Rider</div>
        <div class="rider-terminal-muted">Building...</div>
        <div class="rider-terminal-success">Atlas Rider-style example ready at http://localhost:5000</div>
        <div><span class="rider-prompt">PS</span> C:\source\Atlas&gt; <span class="rider-caret"></span></div>
    </section>
}
else if (Content.Reference.ResourceId == "editor-readme")
{
    <article class="rider-editor rider-markdown" aria-label="README preview">
        <div class="rider-breadcrumbs">Atlas.Examples.Rider <span>›</span> README.md</div>
        <div class="rider-markdown-body">
            <h1>Atlas Rider-style example</h1>
            <p>Compose an IDE workspace from Atlas public components.</p>
            <h2>Layout</h2>
            <ul>
                <li>Project and Services tool groups</li>
                <li>Document tabs in the central editor</li>
                <li>Resizable Terminal at the bottom</li>
            </ul>
            <pre><code>dotnet run --project examples/Atlas.Examples.Rider</code></pre>
        </div>
    </article>
}
else if (Content.Reference.ResourceId == "editor-workspace")
{
    <section class="rider-editor" aria-label="Razor editor">
        <div class="rider-breadcrumbs">Atlas.Examples.Rider <span>›</span> Components <span>›</span> RiderWorkspace.razor</div>
        <div class="rider-code-grid" aria-label="RiderWorkspace.razor source preview">
            <div class="rider-gutter">1<br />2<br />3<br />4<br />5<br />6<br />7<br />8</div>
            <pre><code><span class="rider-tag">&lt;AtlasWorkspaceHost</span> WorkspaceId=<span class="rider-string">"rider-example"</span><span class="rider-tag">&gt;</span>
    <span class="rider-tag">&lt;AtlasSplitDefinition</span> Axis=<span class="rider-string">"BlockChildren"</span><span class="rider-tag">&gt;</span>
        <span class="rider-tag">&lt;AtlasToolGroupDefinition</span> Title=<span class="rider-string">"Project"</span> <span class="rider-tag">/&gt;</span>
        <span class="rider-tag">&lt;AtlasDocumentGroupDefinition&gt;</span>
            <span class="rider-tag">&lt;AtlasDocumentItemDefinition</span> Title=<span class="rider-string">"Program.cs"</span> <span class="rider-tag">/&gt;</span>
        <span class="rider-tag">&lt;/AtlasDocumentGroupDefinition&gt;</span>
    <span class="rider-tag">&lt;/AtlasSplitDefinition&gt;</span>
<span class="rider-tag">&lt;/AtlasWorkspaceHost&gt;</span></code></pre>
        </div>
    </section>
}
else
{
    <section class="rider-editor" aria-label="Code editor">
        <div class="rider-breadcrumbs">Atlas.Examples.Rider <span>›</span> Program.cs</div>
        <div class="rider-code-grid" aria-label="Program.cs source preview">
            <div class="rider-gutter">1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9<br />10<br />11</div>
            <pre><code><span class="rider-keyword">using</span> Atlas.Blazor.DependencyInjection;
<span class="rider-keyword">using</span> Atlas.Examples.Rider;
<span class="rider-keyword">using</span> Microsoft.AspNetCore.Components.Web;
<span class="rider-keyword">using</span> Microsoft.AspNetCore.Components.WebAssembly.Hosting;

<span class="rider-keyword">var</span> builder = WebAssemblyHostBuilder.CreateDefault(args);
builder.RootComponents.Add&lt;App&gt;(<span class="rider-string">"#app"</span>);
builder.RootComponents.Add&lt;HeadOutlet&gt;(<span class="rider-string">"head::after"</span>);
builder.Services.AddAtlasWorkspace();

<span class="rider-keyword">await</span> builder.Build().RunAsync();</code></pre>
        </div>
    </section>
}

@code {
    [Parameter]
    [EditorRequired]
    public AtlasContentContext Content { get; set; } = null!;
}
