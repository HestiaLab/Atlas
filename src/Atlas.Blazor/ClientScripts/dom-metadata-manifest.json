{
  "workspaceRoot": {
    "selector": ".atlas-v2-workspace",
    "requiredAttributes": [
      "data-atlas-host-id",
      "data-atlas-workspace-id",
      "data-atlas-protocol-version",
      "data-atlas-revision",
      "data-atlas-reduced-motion",
      "role",
      "aria-label"
    ]
  },
  "split": {
    "selector": "[data-atlas-node-kind=split]",
    "requiredAttributes": [
      "data-atlas-node-id",
      "data-atlas-split-axis",
      "data-atlas-split-locked",
      "data-atlas-revision"
    ]
  },
  "splitter": {
    "selector": "[data-atlas-split-id]",
    "requiredAttributes": [
      "data-atlas-split-id",
      "role",
      "aria-label",
      "aria-orientation",
      "aria-disabled"
    ]
  },
  "collapseControl": {
    "selector": "[data-atlas-collapse-child]"
  },
  "panelClose": {
    "selector": "[data-atlas-close-panel]"
  },
  "group": {
    "selector": "[data-atlas-group-id]"
  },
  "groupRegion": {
    "selector": ".atlas-v2-group[data-atlas-group-id]",
    "requiredAttributes": [
      "role",
      "aria-labelledby"
    ]
  },
  "toolGroup": {
    "selector": "[data-atlas-group-kind=tool][data-atlas-group-id]",
    "requiredAttributes": [
      "data-atlas-group-kind",
      "data-atlas-group-id",
      "role",
      "aria-labelledby"
    ]
  },
  "dragSource": {
    "selector": "[data-atlas-drag-kind]",
    "requiredAttributes": [
      "data-atlas-drag-kind",
      "data-atlas-item-id",
      "data-atlas-command-capabilities"
    ]
  },
  "documentTab": {
    "selector": "[data-atlas-drag-kind=document-tab]",
    "requiredAttributes": [
      "data-atlas-group-id",
      "data-atlas-insertion-index",
      "id",
      "role",
      "aria-label",
      "aria-selected",
      "aria-controls",
      "tabindex"
    ]
  },
  "tabStrip": {
    "selector": "[data-atlas-overflow-mode]",
    "requiredAttributes": [
      "data-atlas-overflow-mode",
      "role"
    ]
  },
  "tabBar": {
    "selector": "[data-atlas-tab-bar]"
  },
  "tabOverflowButton": {
    "selector": "[data-atlas-overflow-menu-button]",
    "requiredAttributes": [
      "aria-haspopup",
      "aria-expanded",
      "aria-controls"
    ]
  },
  "tabMenu": {
    "selector": "[data-atlas-tab-menu]",
    "requiredAttributes": [
      "role"
    ]
  },
  "tabContextMenu": {
    "selector": "[data-atlas-tab-context-menu]",
    "requiredAttributes": [
      "role"
    ]
  },
  "autoHideOwner": {
    "selector": "[data-atlas-auto-hide-owner]"
  },
  "autoHideEntry": {
    "selector": "[data-atlas-auto-hide-entry]",
    "requiredAttributes": [
      "id",
      "role",
      "aria-label",
      "aria-selected",
      "aria-expanded",
      "aria-controls",
      "tabindex",
      "data-atlas-item-id",
      "data-atlas-toolbar-region"
    ]
  },
  "autoHideFlyout": {
    "selector": "[data-atlas-auto-hide-flyout]",
    "requiredAttributes": [
      "role",
      "aria-hidden"
    ]
  },
  "panelHeader": {
    "selector": "[data-atlas-panel-header]",
    "requiredAttributes": [
      "data-atlas-group-id",
      "data-atlas-insertion-index",
      "id",
      "role",
      "aria-level"
    ]
  },
  "toolbarEntry": {
    "selector": "[data-atlas-toolbar-entry]",
    "requiredAttributes": [
      "data-atlas-group-id",
      "data-atlas-toolbar-region",
      "data-atlas-insertion-index",
      "id",
      "role",
      "aria-label",
      "aria-selected",
      "aria-controls",
      "tabindex"
    ]
  },
  "contentOutlet": {
    "selector": ".atlas-v2-content-outlet",
    "requiredAttributes": [
      "id",
      "role",
      "aria-labelledby",
      "tabindex"
    ]
  },
  "dropScaffold": {
    "selector": "[data-atlas-drop-scaffold=\"true\"]",
    "requiredAttributes": [
      "data-atlas-group-id",
      "data-atlas-toolbar-region",
      "data-atlas-insertion-index",
      "role",
      "aria-hidden"
    ]
  },
  "floatingLayer": {
    "selector": "[data-atlas-floating-layer=\"true\"]",
    "requiredAttributes": [
      "data-atlas-host-id"
    ]
  },
  "floatingWindow": {
    "selector": "[data-atlas-floating-window=\"true\"]",
    "requiredAttributes": [
      "role",
      "aria-modal",
      "aria-label",
      "data-atlas-host-id",
      "data-atlas-item-id",
      "data-atlas-revision"
    ]
  },
  "floatingHeader": {
    "selector": "[data-atlas-drag-kind=floating-window]",
    "requiredAttributes": [
      "data-atlas-item-id",
      "data-atlas-item-kind",
      "data-atlas-floating-item-id",
      "data-atlas-command-capabilities",
      "role",
      "aria-level",
      "id"
    ]
  },
  "floatingResizeHandle": {
    "selector": "[data-atlas-floating-resize]",
    "requiredAttributes": [
      "data-atlas-floating-resize",
      "aria-hidden"
    ]
  },
  "floatingEntry": {
    "selector": "[data-atlas-floating-entry=\"true\"]",
    "requiredAttributes": [
      "data-atlas-item-id",
      "data-atlas-drag-kind",
      "data-atlas-toolbar-entry"
    ]
  },
  "floatingClose": {
    "selector": "[data-atlas-close-floating=\"true\"]",
    "requiredAttributes": [
      "aria-label"
    ]
  },
  "sandboxFrame": {
    "selector": "iframe[data-atlas-sandbox-frame]",
    "requiredAttributes": [
      "data-atlas-protocol-version",
      "data-atlas-workspace-id",
      "data-atlas-item-id",
      "data-atlas-generation",
      "data-atlas-max-message-bytes",
      "sandbox",
      "referrerpolicy"
    ]
  }
}
