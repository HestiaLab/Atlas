<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Atlas.Blazor</RootNamespace>
    <AssemblyName>Atlas.Blazor</AssemblyName>
    <PackageId>Atlas.Blazor</PackageId>
    <Description>Dockable workspace component library for Blazor: tool panels, editor tabs, split views, drag-and-drop, and layout persistence.</Description>
    <PackageTags>blazor;dock;layout;workspace;ide;splitter;drag-drop</PackageTags>
    <Authors>HestiaLab</Authors>
    <RepositoryUrl>https://github.com/HestiaLab/Atlas</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>package-readme.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="package-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="Atlas.Blazor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Core\Atlas.Core.csproj" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Single-package distribution: embed Atlas.Core.dll into the Atlas.Blazor
      nupkg so consumers install one package and get both assemblies. The
      PrivateAssets="all" project reference keeps Atlas.Core out of the nuspec
      dependency list (no external package required), and the build-output
      hook below adds the Core assembly to the package's lib/<tfm> folder.
    -->
    <None Include="$(OutputPath)Atlas.Core.dll"
          Pack="true"
          PackagePath="lib\$(TargetFramework)" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="package.json" Pack="false" />
    <Content Update="package-lock.json" Pack="false" />
    <Content Update="tsconfig.json" Pack="false" />
  </ItemGroup>

  <!--
    Inputs for the incremental atlas.js rebuild. MSBuild only compares
    timestamped file lists, so these must be real ItemGroups (a raw glob
    string in Inputs is never expanded and the target would run every build).
  -->
  <ItemGroup>
    <AtlasClientScript Include="ClientScripts\**\*.ts" />
    <AtlasClientScript Include="ClientScripts\**\*.json" />
    <AtlasClientScript Include="package.json" />
    <AtlasClientScript Include="package-lock.json" />
    <AtlasClientScript Include="tsconfig.json" />
  </ItemGroup>

  <!--
    Rebuild the bundled atlas.js whenever the TypeScript sources (or the npm
    manifest) are newer than the generated bundle. The bundle is gitignored,
    so a plain clone plus `dotnet build` would otherwise silently consume a
    stale or missing atlas.js (drag sessions, attach retry, etc. regress).

    Incremental: MSBuild compares the inputs above against the bundle output
    and skips this target when the bundle is up to date. When npm is not
    available (pure .NET build machine), we warn instead of failing so the
    C# build still proceeds; the caller must run `npm run build:js` before
    packing or serving.
  -->
  <Target Name="EnsureAtlasJsBundle"
          BeforeTargets="BeforeBuild"
          Inputs="@(AtlasClientScript)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\atlas-v2\atlas.js">
    <Exec Condition="'$(AtlasSkipJsBuild)' != 'true'"
          Command="npm run build:js"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
