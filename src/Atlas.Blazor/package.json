{
  "name": "@atlas/blazor-client-scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:js": "esbuild ./tests/protocol.test.ts --bundle --platform=node --format=esm --outfile=./obj/tests/protocol.test.mjs && node --test ./obj/tests/protocol.test.mjs",
    "build:js": "esbuild ./ClientScripts/public-api.ts --bundle --format=esm --platform=browser --target=es2020 --sourcemap --outfile=./wwwroot/atlas-v2/atlas.js"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
