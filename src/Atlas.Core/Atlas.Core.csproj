<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Atlas.Core</RootNamespace>
    <AssemblyName>Atlas.Core</AssemblyName>
    <PackageId>Atlas.Core</PackageId>
    <Description>UI-independent layout domain and operation engine for Atlas.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <InternalsVisibleTo Include="Atlas.Blazor.Tests" />
    <InternalsVisibleTo Include="Atlas.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Persistence\Schema\atlas-workspace-v2.xsd"
          Pack="true"
          PackagePath="contentFiles\any\any\Persistence\Schema" />
    <EmbeddedResource Include="Persistence\Schema\atlas-workspace-v2.xsd" />
  </ItemGroup>
</Project>
