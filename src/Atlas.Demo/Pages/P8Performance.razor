@page "/p8-performance"
@using Atlas.Blazor.Components
@using Atlas.Blazor.Content
@using Atlas.Core
@using Atlas.Core.Placement
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Atlas P8 performance verification</PageTitle>

<h1>Atlas P8 performance verification</h1>

<output id="p8-performance-evidence"
        data-testid="p8-performance-evidence"
        data-panel-count="0"></output>

@if (showWorkspace)
{
    <div class="p8-performance-host" data-testid="p8-performance-host">
        <AtlasWorkspaceHost WorkspaceId="@(new WorkspaceId("p8-performance"))"
                            ChildContent="@definition"
                            ContentTemplate="@Content" />
    </div>
}

@code {
    private readonly RenderFragment definition;
    private bool showWorkspace;

    public P8Performance()
    {
        definition = BuildDefinition();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("atlasP8.beginPanelMeasurement", 20);
        showWorkspace = true;
        StateHasChanged();
    }

    private static RenderFragment<AtlasContentContext> Content =>
        context => builder => builder.AddContent(0, context.Item.Title);

    private static RenderFragment BuildDefinition()
    {
        return builder =>
        {
            builder.OpenComponent<AtlasToolGroupDefinition>(0);
            builder.AddAttribute(1, "Id", new LayoutNodeId("performance-tools"));
            builder.AddAttribute(2, "LogicalRegion", LogicalRegion.InlineStartUpper);
            builder.AddAttribute(
                3,
                "ChildContent",
                (RenderFragment)(items =>
                {
                    for (var index = 0; index < 20; index++)
                    {
                        var sequence = index * 10;
                        items.OpenComponent<AtlasToolItemDefinition>(sequence);
                        items.AddAttribute(sequence + 1, "Id", new DockItemId($"tool-{index}"));
                        items.AddAttribute(sequence + 2, "ContentKind", "tool");
                        items.AddAttribute(sequence + 3, "ResourceId", $"resource-{index}");
                        items.AddAttribute(sequence + 4, "Title", $"Tool {index}");
                        items.CloseComponent();
                    }
                }));
            builder.CloseComponent();
        };
    }
}
