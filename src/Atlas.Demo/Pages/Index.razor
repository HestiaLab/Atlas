@page "/"
@implements IAsyncDisposable
@using Atlas.Blazor.Components
@using Atlas.Blazor.Content
@using Atlas.Core
@using Atlas.Core.Definitions
@using Atlas.Core.Items
@using Atlas.Core.Layout
@using Atlas.Core.Operations.Engine
@using Microsoft.AspNetCore.Components.Rendering

<PageTitle>Atlas P7 verification</PageTitle>

<h1>Atlas P7 content verification</h1>

<button data-testid="p7-send-unknown" type="button">Send unknown sandbox message</button>
<button data-testid="p7-send-oversized" type="button">Send oversized sandbox message</button>

@if (workspace is not null)
{
    <div class="p7-demo-host" data-testid="p7-demo-host">
        <AtlasWorkspaceHost Workspace="@workspace"
                            ContentLifetimeOptions="@lifetimeOptions"
                            ContentTemplate="@contentTemplate"
                            SandboxedFrameResolver="@ResolveSandbox" />
    </div>
}

@code {
    private readonly WorkspaceContentLifetimeOptions lifetimeOptions = new(
        AtlasContentLifetimeMode.KeepAliveWithinGroup,
        maxCachedItems: 2);
    private readonly RenderFragment<AtlasContentContext> contentTemplate;
    private IAtlasWorkspace? workspace;

    [Inject]
    private IAtlasWorkspaceFactory Factory { get; set; } = null!;

    public Index()
    {
        contentTemplate = context => builder =>
        {
            builder.OpenComponent<P7TrackedContent>(0);
            builder.SetKey(context.ItemId);
            builder.AddAttribute(1, "Content", context);
            builder.CloseComponent();
        };
    }

    protected override void OnInitialized()
    {
        var first = Item("first", "trusted");
        var second = Item("second", "trusted");
        var sandbox = Item("sandbox", "sandbox");
        var group = new GroupNode(
            new LayoutNodeId("documents"),
            DockItemKind.Document,
            GroupRetentionPolicy.Persistent,
            GroupVisibility.Expanded,
            new[] { first.Id, second.Id, sandbox.Id },
            first.Id);
        var result = Factory.Create(
            new AtlasWorkspaceDefinition(
                new WorkspaceId("p7-demo"),
                group.Id,
                new LayoutNode[] { group },
                new[] { first, second, sandbox }));
        if (!result.Succeeded)
        {
            throw new InvalidOperationException(result.Error?.DiagnosticId);
        }

        workspace = result.Value;
    }

    private static DockItem Item(string id, string kind)
    {
        return new DockItem(
            new DockItemId(id),
            DockItemKind.Document,
            new ContentReference(kind, $"resource-{id}"),
            DockItemCapabilityPresets.Document,
            title: id);
    }

    private static AtlasSandboxedFrameOptions? ResolveSandbox(AtlasContentContext context)
    {
        return context.Reference.Kind == "sandbox"
            ? new AtlasSandboxedFrameOptions(
                "/p7-sandbox-child.html",
                "P7 untrusted content",
                maxMessageBytes: 4096)
            : null;
    }

    public async ValueTask DisposeAsync()
    {
        if (workspace is not null)
        {
            await workspace.DisposeAsync();
        }
    }
}
