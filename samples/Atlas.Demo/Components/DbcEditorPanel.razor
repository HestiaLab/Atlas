@namespace Atlas.Demo.Components
@using Atlas.Blazor.Content
@using Atlas.Demo.Models.Dbc
@using Atlas.Demo.Services
@using Atlas.Demo.ViewModels
@implements IDisposable

<div class="dbc-editor" data-testid="dbc-editor" aria-label="DBC editor">
    @if (Model.FileName is null)
    {
        <p class="dbc-empty">Select a .dbc file in the explorer to edit it.</p>
    }
    else
    {
        <div class="dbc-editor-toolbar">
            <span class="dbc-editor-file">@Model.Folder / @Model.FileName</span>
            <button type="button"
                    class="dbc-action @(Model.Mode == DbcEditorModel.ViewMode.Text ? "active" : "")"
                    @onclick="() => Model.SetMode(DbcEditorModel.ViewMode.Text)">Text</button>
            <button type="button"
                    class="dbc-action @(Model.Mode == DbcEditorModel.ViewMode.Table ? "active" : "")"
                    @onclick="() => Model.SetMode(DbcEditorModel.ViewMode.Table)">Table</button>
        </div>

        @if (Model.Mode == DbcEditorModel.ViewMode.Text)
        {
            <div class="dbc-editor-text">
                <textarea @bind="Model.EditedContent"
                          class="dbc-textarea"
                          spellcheck="false"
                          aria-label="DBC raw text"></textarea>
                <div class="dbc-editor-actions">
                    <button type="button" class="dbc-action primary"
                            @onclick="Model.Save">Save</button>
                </div>
            </div>
        }
        else
        {
            <div class="dbc-editor-table">
                @if (Model.Document is null)
                {
                    <p class="dbc-empty">This file could not be parsed as DBC.</p>
                }
                else if (Model.Document.Messages.Count == 0)
                {
                    <p class="dbc-empty">No messages in this DBC file.</p>
                }
                else
                {
                    <table class="dbc-table">
                        <thead>
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Name</th>
                                <th scope="col">Len</th>
                                <th scope="col">Transmitter</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model.Document.Messages)
                            {
                                <tr class="dbc-message-row" data-message-id="@message.Id">
                                    <td>@message.Id</td>
                                    <td>
                                        <button type="button"
                                                class="dbc-link"
                                                data-testid="dbc-message"
                                                @onclick="() => HandleMessageSelected(message)">
                                            @message.Name
                                        </button>
                                    </td>
                                    <td>@message.Length</td>
                                    <td>@message.Transmitter</td>
                                </tr>
                                @foreach (var signal in message.Signals)
                                {
                                    <tr class="dbc-signal-row" data-signal-id="@signal.Name">
                                        <td></td>
                                        <td>
                                            <button type="button"
                                                    class="dbc-link"
                                                    data-testid="dbc-signal"
                                                    @onclick="() => HandleSignalSelected(message, signal)">
                                                ⤷ @signal.Name
                                            </button>
                                        </td>
                                        <td>@signal.Length</td>
                                        <td>@signal.Receiver</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
</div>

@code {
    private string? _syncedTitle;

    /// <summary>
    /// The editor model. Single-panel tests pass it directly; the workspace
    /// path leaves it unset and the panel resolves the per-item model from the
    /// content state scope during initialization (FR-01).
    /// </summary>
    [Parameter]
    public DbcEditorModel Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public AtlasContentContext Content { get; set; } = null!;

    /// <summary>Gets or sets the shared DBC file store used to resolve models from Context.</summary>
    [Parameter]
    public DbcFileStore? Store { get; set; }

    /// <summary>Gets or sets the explorer model used to open the current selection into a fresh model.</summary>
    [Parameter]
    public DbcTreeModel? Tree { get; set; }

    [Parameter]
    public EventCallback<DbcMessage> OnMessageSelected { get; set; }

    [Parameter]
    public EventCallback<DbcSignal> OnSignalSelected { get; set; }

    protected override void OnInitialized()
    {
        if (Model is null)
        {
            if (Content is null)
            {
                throw new InvalidOperationException(
                    "DbcEditorPanel requires a Model or a Content context.");
            }

            Model = Content.GetOrCreateState<DbcEditorModel>(CreateModel);
        }

        Model.StateChanged += OnModelChanged;
    }

    private DbcEditorModel CreateModel()
    {
        if (Store is null)
        {
            throw new InvalidOperationException(
                "A DbcFileStore is required to resolve an editor model from Content.");
        }

        var model = new DbcEditorModel(Store);

        // The factory runs once per ContentReference, when the item first
        // renders. At that moment the explorer selection is the file this tab
        // was opened for, so open it into the fresh model.
        if (Tree is not null
            && Tree.SelectedFolder is not null
            && Tree.SelectedFile is not null
            && string.Equals(
                Tree.SelectedFile,
                Content.Reference.ResourceId,
                StringComparison.Ordinal))
        {
            var file = Store.Find(Tree.SelectedFolder, Tree.SelectedFile);
            if (file is not null)
            {
                model.Open(Tree.SelectedFolder, file.Name, file.Content, file.Parsed);
            }
        }

        return model;
    }

    private void OnModelChanged()
    {
        if (_syncedTitle != Model.FileName)
        {
            // Only a file switch changes the tab title; updating presentation
            // on every StateChanged (view mode toggles, save) would pollute
            // the workspace Undo history with no-op presentation operations.
            _syncedTitle = Model.FileName;
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                if (Content is not null && Model.FileName is not null)
                {
                    await Content.Commands.UpdatePresentationAsync(Model.FileName, iconKey: null);
                }
            });
        }
        else
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private Task HandleMessageSelected(DbcMessage message)
    {
        return OnMessageSelected.InvokeAsync(message);
    }

    private Task HandleSignalSelected(DbcMessage message, DbcSignal signal)
    {
        return OnSignalSelected.InvokeAsync(signal);
    }

    public void Dispose()
    {
        Model.StateChanged -= OnModelChanged;
    }
}
