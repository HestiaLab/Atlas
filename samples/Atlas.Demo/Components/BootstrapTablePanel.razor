@namespace Atlas.Demo.Components
@using Atlas.Demo.Models

@* Panel B: a third-party-style table adapter. It receives Items as a normal
   Blazor parameter (supplied through AtlasContentMap) and renders Bootstrap
   table markup without any Atlas-specific base type. *@
<div class="bootstrap-table"
     data-testid="products-table"
     aria-label="Products table">
    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items ?? Array.Empty<ProductItem>())
            {
                <tr data-product-id="@item.Id">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Items is null || Items.Count == 0)
    {
        <p class="text-muted" data-testid="products-empty">No products to display.</p>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<ProductItem>? Items { get; set; }
}
