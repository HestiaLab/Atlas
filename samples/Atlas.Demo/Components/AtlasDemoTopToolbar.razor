<header class="atlas-demo-topbar" data-testid="atlas-demo-top-toolbar">
    <div class="atlas-demo-product" aria-label="Atlas Demo">A</div>
    <nav class="atlas-demo-menu" aria-label="Application menu">
        <button type="button">File</button>
        <button type="button">Edit</button>
        <button type="button">View</button>
        <button type="button">Navigate</button>
        <button type="button">Code</button>
        <button type="button">Run</button>
    </nav>
    <div class="atlas-demo-history" aria-label="Layout history">
        <button type="button" disabled="@(!CanUndo)" @onclick="OnUndo" aria-label="Undo layout change">↶</button>
        <button type="button" disabled="@(!CanRedo)" @onclick="OnRedo" aria-label="Redo layout change">↷</button>
    </div>
    <div class="atlas-demo-runner">
        <span class="atlas-demo-branch">feature/atlas-demo</span>
        <button class="atlas-demo-target" type="button" aria-label="Run target">Atlas.Demo</button>
        <button class="atlas-demo-run" type="button" aria-label="Run Atlas Demo">▶</button>
        <button type="button" aria-label="Debug Atlas Demo">◆</button>
        <button type="button" aria-label="Search">⌕</button>
    </div>
</header>

@code {
    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public bool CanRedo { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public EventCallback OnRedo { get; set; }
}
