@inherits AtlasContentComponent
@using Atlas.Blazor.Content

@switch (Content.Reference.ResourceId)
{
    case "project":
        <section class="atlas-demo-tool" aria-label="Project tree">
            <div class="atlas-demo-tool-actions"><strong>Atlas</strong><button type="button" aria-label="Collapse project tree">⌃</button></div>
            <ul class="atlas-demo-tree">
                <li><span>⌄</span><strong>Atlas</strong></li>
                <li class="level-1"><span>⌄</span>samples</li>
                <li class="level-2"><span>⌄</span>Atlas.Demo</li>
                <li class="level-3 active">◇ Workspace.razor</li>
                <li class="level-3">♯ Program.cs</li>
                <li class="level-3">◇ app.css</li>
                <li class="level-1"><span>›</span>src</li>
                <li class="level-1"><span>›</span>tests</li>
            </ul>
        </section>
        break;
    case "structure":
        <section class="atlas-demo-tool" aria-label="Code structure">
            <ul class="atlas-demo-list">
                <li><strong>AtlasDemoWorkspace</strong></li>
                <li>OnInitialized()</li>
                <li>UndoAsync()</li>
                <li>RedoAsync()</li>
                <li>DisposeAsync()</li>
            </ul>
        </section>
        break;
    case "services":
        <section class="atlas-demo-tool" aria-label="Services">
            <div class="atlas-demo-service"><span class="running"></span><div><strong>Atlas.Demo</strong><small>Running on localhost</small></div></div>
            <div class="atlas-demo-service"><span></span><div><strong>Docker</strong><small>Not connected</small></div></div>
            <div class="atlas-demo-service"><span class="running"></span><div><strong>NuGet feed</strong><small>0.0.0-dev</small></div></div>
        </section>
        break;
    case "database":
        <section class="atlas-demo-tool" aria-label="Database">
            <ul class="atlas-demo-list">
                <li><span class="atlas-demo-muted">□</span> Data Sources</li>
                <li class="level-1"><span class="atlas-demo-ok">●</span> atlas-local</li>
                <li class="level-2">Tables</li>
                <li class="level-2">Views</li>
            </ul>
        </section>
        break;
    case "terminal":
        <section class="atlas-demo-terminal" aria-label="Terminal output">
            <div><span class="prompt">PS</span> C:\samples\Atlas.Demo&gt; dotnet run</div>
            <div class="atlas-demo-muted">Building Atlas.Demo from local NuGet packages…</div>
            <div class="atlas-demo-success">Atlas.Demo ready at http://localhost:5078</div>
            <div><span class="prompt">PS</span> C:\samples\Atlas.Demo&gt; <span class="caret"></span></div>
        </section>
        break;
    case "problems":
        <section class="atlas-demo-tool" aria-label="Problems">
            <div class="atlas-demo-empty-icon">✓</div>
            <p>No problems detected</p>
            <small class="atlas-demo-muted">0 errors · 0 warnings</small>
        </section>
        break;
    case "workspace":
        <section class="atlas-demo-editor" aria-label="Workspace.razor source preview">
            <div class="atlas-demo-breadcrumbs">Atlas.Demo <span>›</span> Components <span>›</span> Workspace.razor</div>
            <div class="atlas-demo-code"><div class="gutter">1<br />2<br />3<br />4<br />5<br />6<br />7</div><pre><code><span class="tag">&lt;AtlasWorkspaceHost</span> Workspace=<span class="string">"@@workspace"</span><span class="tag">&gt;</span>
    <span class="tag">&lt;AtlasSplitDefinition</span> Axis=<span class="string">"BlockChildren"</span><span class="tag">&gt;</span>
        <span class="tag">&lt;AtlasToolGroupDefinition</span> LogicalRegion=<span class="string">"InlineStartUpper"</span> <span class="tag">/&gt;</span>
        <span class="tag">&lt;AtlasDocumentGroupDefinition</span> <span class="tag">/&gt;</span>
    <span class="tag">&lt;/AtlasSplitDefinition&gt;</span>
<span class="tag">&lt;/AtlasWorkspaceHost&gt;</span></code></pre></div>
        </section>
        break;
    case "readme":
        <article class="atlas-demo-editor atlas-demo-markdown" aria-label="README preview">
            <div class="atlas-demo-breadcrumbs">Atlas.Demo <span>›</span> README.md</div>
            <div class="markdown-body">
                <h1>Atlas.Demo</h1>
                <p>A portable <strong>NuGet consumer sample</strong> for Atlas.Core and Atlas.Blazor.</p>
                <h2>Restore</h2>
                <pre><code>dotnet restore Atlas.Demo.sln --configfile NuGet.Config</code></pre>
                <p>The layout code remains unchanged when this directory moves outside the Atlas repository.</p>
            </div>
        </article>
        break;
    default:
        <section class="atlas-demo-editor" aria-label="Program.cs source preview">
            <div class="atlas-demo-breadcrumbs">Atlas.Demo <span>›</span> Program.cs</div>
            <div class="atlas-demo-code"><div class="gutter">1<br />2<br />3<br />4<br />5<br />6<br />7<br />8</div><pre><code><span class="keyword">using</span> Atlas.Blazor.DependencyInjection;
<span class="keyword">using</span> Microsoft.AspNetCore.Components.WebAssembly.Hosting;

<span class="keyword">var</span> builder = WebAssemblyHostBuilder.CreateDefault(args);
builder.RootComponents.Add&lt;App&gt;(<span class="string">"#app"</span>);
builder.Services.AddAtlasWorkspace();

<span class="keyword">await</span> builder.Build().RunAsync();</code></pre></div>
        </section>
        break;
}
