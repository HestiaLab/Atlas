@implements IAsyncDisposable
@using Atlas.Blazor.Components
@using Atlas.Blazor.Content
@using Atlas.Core
@using Atlas.Core.Changes
@using Atlas.Demo.Models.Dbc
@using Atlas.Demo.Services
@using Atlas.Demo.ViewModels

<section class="atlas-demo-shell" aria-label="Atlas IDE consumer sample">
    @if (workspace is null)
    {
        <div class="atlas-demo-loading" role="status">Preparing Atlas workspace…</div>
    }
    else
    {
        <AtlasWorkspaceHost Workspace="@workspace"
                            WorkspaceOwnership="WorkspaceOwnership.External"
                            TopToolbarContent="@topToolbar"
                            StatusBarContent="@statusBar"
                            EnableInteractions="true">
            <ContentRoutes>
                <AtlasContentRoute Kind="dbc-tree">
                    <ChildContent Context="content">
                        <DbcTreePanel Model="dbcTree" />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="dbc-editor">
                    <ChildContent Context="content">
                        <DbcEditorPanel Model="dbcEditor"
                                        OnMessageSelected="ShowMessageProperties"
                                        OnSignalSelected="ShowSignalProperties" />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="dbc-property">
                    <ChildContent Context="content">
                        <DbcPropertyPanel Model="dbcProperty" />
                    </ChildContent>
                </AtlasContentRoute>
            </ContentRoutes>

            <ErrorTemplate Context="content">
                @content.Code
            </ErrorTemplate>
        </AtlasWorkspaceHost>
    }
</section>

@code {
    private readonly DbcFileStore dbcStore = new();
    private DbcTreeModel dbcTree = null!;
    private DbcEditorModel dbcEditor = null!;
    private DbcPropertyModel dbcProperty = null!;
    private readonly RenderFragment topToolbar;
    private readonly RenderFragment statusBar;
    private IAtlasWorkspace? workspace;
    private string operationStatus = "Ready";

    [Inject]
    private IAtlasWorkspaceFactory Factory { get; set; } = null!;

    [Parameter]
    public string WorkspaceName { get; set; } = "atlas-demo";

    public AtlasDemoWorkspace()
    {
        topToolbar = builder =>
        {
            builder.OpenComponent<AtlasDemoTopToolbar>(0);
            builder.AddAttribute(1, nameof(AtlasDemoTopToolbar.CanUndo), workspace?.CanUndo == true);
            builder.AddAttribute(2, nameof(AtlasDemoTopToolbar.CanRedo), workspace?.CanRedo == true);
            builder.AddAttribute(3, nameof(AtlasDemoTopToolbar.OnUndo), EventCallback.Factory.Create(this, UndoAsync));
            builder.AddAttribute(4, nameof(AtlasDemoTopToolbar.OnRedo), EventCallback.Factory.Create(this, RedoAsync));
            builder.CloseComponent();
        };
        statusBar = builder =>
        {
            builder.OpenComponent<AtlasDemoStatusBar>(0);
            builder.AddAttribute(1, nameof(AtlasDemoStatusBar.OperationStatus), operationStatus);
            builder.CloseComponent();
        };
    }

    protected override void OnInitialized()
    {
        var result = Factory.Create(AtlasDemoWorkspaceDefinition.Create(WorkspaceName));
        if (!result.Succeeded || result.Value is null)
        {
            throw new InvalidOperationException(result.Error?.DiagnosticId ?? "Atlas Demo initialization failed.");
        }

        workspace = result.Value;
        workspace.Changed += OnWorkspaceChanged;

        dbcTree = new DbcTreeModel(dbcStore);
        dbcEditor = new DbcEditorModel(dbcStore);
        dbcProperty = new DbcPropertyModel();
        dbcTree.StateChanged += OnDbcSelectionChanged;
    }

    private void OnDbcSelectionChanged()
    {
        if (dbcTree.SelectedFolder is null || dbcTree.SelectedFile is null)
        {
            return;
        }

        var file = dbcStore.Find(dbcTree.SelectedFolder, dbcTree.SelectedFile);
        if (file is null)
        {
            return;
        }

        dbcEditor.Open(dbcTree.SelectedFolder, file.Name, file.Content, file.Parsed);
        dbcProperty.ShowFile(file);
    }

    private void ShowMessageProperties(DbcMessage message)
    {
        dbcProperty.ShowMessage(message);
    }

    private void ShowSignalProperties(DbcSignal signal)
    {
        dbcProperty.ShowSignal(signal);
    }

    private async Task UndoAsync()
    {
        if (workspace is null)
        {
            return;
        }

        var result = await workspace.UndoAsync();
        operationStatus = result.Succeeded ? "Move undone" : "Nothing to undo";
        await InvokeAsync(StateHasChanged);
    }

    private async Task RedoAsync()
    {
        if (workspace is null)
        {
            return;
        }

        var result = await workspace.RedoAsync();
        operationStatus = result.Succeeded ? "Move redone" : "Nothing to redo";
        await InvokeAsync(StateHasChanged);
    }

    private void OnWorkspaceChanged(object? sender, WorkspaceChangedEventArgs args)
    {
        operationStatus = $"Revision {args.ChangeSet.AfterRevision}";
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (workspace is null)
        {
            return;
        }

        workspace.Changed -= OnWorkspaceChanged;
        await workspace.DisposeAsync();
        workspace = null;
    }
}
