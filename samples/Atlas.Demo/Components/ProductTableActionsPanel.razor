@namespace Atlas.Demo.Components
@using Atlas.Demo.Models

@* Panel A: receives the parent-owned count and a Clear callback through an
   AtlasContentRoute. It owns no Atlas types and no component instance access. *@
<section class="atlas-demo-tool atlas-demo-product-actions"
         aria-label="Product actions"
         data-testid="product-actions">
    <div class="atlas-demo-product-count"
         aria-live="polite"
         data-testid="product-count">@ProductCount products</div>
    <button type="button"
            class="atlas-demo-clear"
            aria-label="Clear products"
            @onclick="() => OnClear.InvokeAsync()">Clear</button>
</section>

@code {
    [Parameter]
    public int ProductCount { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }
}
