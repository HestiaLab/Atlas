@page "/floating-windows"
@namespace Atlas.Showcase.Pages
@implements IAsyncDisposable
@using Atlas.Blazor.Components
@using Atlas.Blazor.Content
@using Atlas.Core
@using Atlas.Core.Definitions
@using Atlas.Core.Items
@using Atlas.Core.Layout
@using Atlas.Core.Operations
@using Atlas.Core.Placement
@inject IAtlasWorkspaceFactory Factory

<PageTitle>Atlas 演示 — 浮动窗口</PageTitle>

<div class="showcase-floating-page">
    <header class="showcase-verification-header">
        <div>
            <h1>浮动窗口</h1>
            <p>
                把工具面板的标题栏或 ToolBar Entry 拖到右侧编辑器区域即可浮出。
                浮窗可拖动、八向缩放、拖回 Dock，或点击标题栏关闭按钮取消浮动。
            </p>
        </div>
        <a class="showcase-declarative-back" href="./">返回首页</a>
    </header>

    <div class="showcase-floating-actions" role="group" aria-label="浮动窗口操作">
        <button type="button" data-testid="float-inspector" @onclick="FloatInspectorAsync">
            通过 API 浮出检查器
        </button>
        <button type="button" data-testid="dock-all" @onclick="DockAllAsync">
            全部停靠
        </button>
        <span data-testid="floating-count">浮动窗口：@FloatingCount</span>
    </div>

    @if (error is not null)
    {
        <p class="showcase-floating-error" role="alert">@error</p>
    }
    else if (workspace is not null)
    {
        <main class="showcase-floating-host" aria-label="浮动窗口演示工作区">
            <AtlasWorkspaceHost Workspace="@workspace" EnableInteractions="true">
                <StatusBarContent>
                    <div class="showcase-declarative-status">
                        REQ-F-152 · 浮动窗口 @FloatingCount 个
                    </div>
                </StatusBarContent>
                <ContentRoutes>
                    <AtlasContentRoute Kind="floating-tool">
                        <ChildContent Context="content">
                            <div class="showcase-tool">
                                <TeachingCard Requirement="REQ-F-152"
                                              Source="FloatingWindowExample.razor">
                                    <p>
                                        拖动这个面板的标题栏到右侧编辑器区域，或拖到 ToolBar
                                        重新停靠。浮窗标题栏关闭按钮会取消浮动并回到原 Group。
                                    </p>
                                    <p>
                                        资源：<code>@content.Reference.Kind /
                                        @content.Reference.ResourceId</code>
                                    </p>
                                </TeachingCard>
                            </div>
                        </ChildContent>
                    </AtlasContentRoute>
                    <AtlasContentRoute Kind="floating-document">
                        <ChildContent Context="content">
                            <div class="showcase-tool">
                                <TeachingCard Requirement="REQ-F-152"
                                              Source="FloatingWindowExample.razor">
                                    <p>
                                        编辑器区域是浮窗投放区：把一个工具面板拖到这里释放，
                                        它就会出现在指针位置。
                                    </p>
                                    <p>资源：<code>@content.Reference.ResourceId</code></p>
                                </TeachingCard>
                            </div>
                        </ChildContent>
                    </AtlasContentRoute>
                </ContentRoutes>
            </AtlasWorkspaceHost>
        </main>
    }
</div>

@code {
    private IAtlasWorkspace? workspace;
    private string? error;
    private DockItemId inspectorId = new("inspector");

    private int FloatingCount => workspace?.Current.FloatingWindows.Count ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var explorer = CreateTool("explorer", "资源管理器");
        var inspector = CreateTool("inspector", "检查器");
        var document = new DockItem(
            new DockItemId("readme"),
            DockItemKind.Document,
            new ContentReference("floating-document", "readme"),
            DockItemCapabilityPresets.Document,
            "README");
        var tools = new GroupNode(
            new LayoutNodeId("tools"),
            DockItemKind.Tool,
            GroupRetentionPolicy.Persistent,
            GroupVisibility.Expanded,
            new[] { explorer.Id, inspector.Id },
            explorer.Id,
            toolbarRegion: LogicalRegion.InlineStartUpper);
        var documents = new GroupNode(
            new LayoutNodeId("documents"),
            DockItemKind.Document,
            GroupRetentionPolicy.Persistent,
            GroupVisibility.Expanded,
            new[] { document.Id },
            document.Id);
        var split = new SplitNode(
            new LayoutNodeId("root"),
            SplitAxis.InlineChildren,
            SplitBasis.FixedPixels(280, SplitAnchor.First),
            new SplitConstraints(180, 420, 240, null),
            tools.Id,
            documents.Id);
        var definition = new AtlasWorkspaceDefinition(
            new WorkspaceId("showcase-floating"),
            split.Id,
            new LayoutNode[] { split, tools, documents },
            new[] { explorer, inspector, document },
            toolBars: new[]
            {
                new ToolBarState(LogicalSide.InlineStart, ToolBarVisibility.Expanded),
            },
            toolBarOrders: new[]
            {
                new ToolBarOrderState(
                    LogicalRegion.InlineStartUpper,
                    new[] { explorer.Id, inspector.Id }),
            });
        var created = Factory.Create(definition);
        if (!created.Succeeded)
        {
            error = $"无法创建演示工作区：{created.Error?.DiagnosticId}";
            return;
        }

        workspace = created.Value!;
        workspace.Changed += OnWorkspaceChanged;
        var floated = await workspace.ExecuteAsync(
            new FloatToolOperation(
                explorer.Id,
                new FloatingWindowGeometry(360d, 60d, 360d, 420d)));
        if (!floated.Succeeded)
        {
            error = $"无法浮出初始面板：{floated.Error?.DiagnosticId}";
        }
    }

    private async Task FloatInspectorAsync()
    {
        if (workspace is null
            || workspace.Current.FloatingWindows.ContainsKey(inspectorId))
        {
            return;
        }

        await workspace.ExecuteAsync(
            new FloatToolOperation(
                inspectorId,
                new FloatingWindowGeometry(520d, 120d, 320d, 360d)));
    }

    private async Task DockAllAsync()
    {
        if (workspace is null)
        {
            return;
        }

        foreach (var itemId in workspace.Current.FloatingWindows.Keys.ToArray())
        {
            await workspace.ExecuteAsync(new DockFloatingToolOperation(itemId));
        }
    }

    private void OnWorkspaceChanged(object? sender, Atlas.Core.Changes.WorkspaceChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
        _ = args;
    }

    public async ValueTask DisposeAsync()
    {
        if (workspace is not null)
        {
            workspace.Changed -= OnWorkspaceChanged;
            await workspace.DisposeAsync();
        }
    }

    private static DockItem CreateTool(string id, string title)
    {
        return new DockItem(
            new DockItemId(id),
            DockItemKind.Tool,
            new ContentReference("floating-tool", id),
            DockItemCapabilityPresets.Tool,
            title);
    }
}
