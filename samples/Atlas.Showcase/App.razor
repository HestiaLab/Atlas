<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <PageTitle>页面不存在 — Atlas 演示</PageTitle>
        <main class="showcase-not-found" role="alert">
            <h1>页面不存在</h1>
            <p>请求的演示页面不存在。</p>
            <a href="./">返回首页</a>
        </main>
    </NotFound>
</Router>
