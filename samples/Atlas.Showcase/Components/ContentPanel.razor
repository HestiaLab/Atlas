@namespace Atlas.Showcase.Components

<div class="showcase-tool">
    <TeachingCard Title="内容注册"
                  Requirement="REQ-F-006 · REQ-F-007 · REQ-F-008"
                  CodeSnippet="@Code">
        <p>面板和标签页渲染按 <em>Kind</em> 注册的组件。生效的 Content
        Catalog 合并了启动时 DI 注册、宿主内 <code>AtlasContentRoute</code>
        声明以及函数式映射。</p>
        <p>本演示在宿主内用 <code>AtlasContentRoute</code> 注册了每个面板
        （见 <code>ShowcaseWorkspace.razor</code>）。</p>
        <p><span class="showcase-tag accent">试一试</span> 你现在看到的所有
        面板都是通过路由注册的内容。</p>
    </TeachingCard>
</div>

@code {
    private const string Code = @"<AtlasContentRoute Kind=""explorer"">
  <ChildContent Context=""content"">
    <ExplorerPanel />
  </ChildContent>
</AtlasContentRoute>

// 另一种方式：在 Program.cs 中通过 DI 注册
builder.Services.AddAtlasContent<ExplorerPanel>(""explorer"");";
}
