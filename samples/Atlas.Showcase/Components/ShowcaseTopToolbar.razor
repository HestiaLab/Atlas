@namespace Atlas.Showcase.Components
@using Atlas.Core
@using Microsoft.JSInterop

<header class="showcase-topbar" data-testid="showcase-top-toolbar">
    <div class="showcase-brand" aria-label="Atlas Showcase">A</div>
    <nav class="showcase-menu" aria-label="演示导航">
        <button type="button" @onclick="() => OnOpenGuide.InvokeAsync()">指南</button>
        <button type="button" @onclick="() => OnOpenCatalog.InvokeAsync()">能力</button>
        <button type="button" @onclick="() => OnOpenTheme.InvokeAsync()">主题</button>
        @if (ShowVerificationLink)
        {
            <button class="showcase-verify" type="button" @onclick="() => OnOpenVerification.InvokeAsync()">验证</button>
        }
    </nav>
    <div class="showcase-history" aria-label="布局历史">
        <button type="button" disabled="@(!CanUndo)" @onclick="() => OnUndo.InvokeAsync()" aria-label="撤销布局更改">↶</button>
        <button type="button" disabled="@(!CanRedo)" @onclick="() => OnRedo.InvokeAsync()" aria-label="重做布局更改">↷</button>
    </div>
    <div class="showcase-actions">
        <div class="showcase-quickmenu" @onkeydown="OnDialogKeyDown">
            <button class="showcase-action"
                    type="button"
                    @ref="menuButton"
                    aria-haspopup="dialog"
                    aria-expanded="@(PanelManagerOpen ? "true" : "false")"
                    aria-controls="showcase-panel-manager"
                    @onclick="TogglePanelManagerAsync">
                ☰ 面板
            </button>
            @if (PanelManagerOpen)
            {
                <div class="showcase-dialog-backdrop" @onclick="ClosePanelManagerAsync"></div>
                <section id="showcase-panel-manager"
                         class="showcase-panel-manager"
                         role="dialog"
                         aria-modal="false"
                         aria-labelledby="showcase-panel-manager-title"
                         tabindex="-1"
                         @ref="managerElement"
                         @onkeydown="OnDialogKeyDown">
                    <header class="showcase-panel-manager-header">
                        <h2 id="showcase-panel-manager-title">面板管理</h2>
                        <button type="button"
                                class="showcase-panel-manager-close"
                                @onclick="ClosePanelManagerAsync"
                                aria-label="关闭面板管理">关闭</button>
                    </header>
                    <div class="showcase-panel-manager-actions">
                        <button type="button" @onclick="ToggleCompactAsync">
                            @(IsCompact ? "使用标准布局" : "使用紧凑布局")
                        </button>
                        <button type="button" @onclick="ResetAsync">重置布局</button>
                    </div>
                    <ul class="showcase-panel-manager-list">
                        @foreach (var view in Panels)
                        {
                            var current = view;
                            var targets = MoveTargets(current);
                            <li class="showcase-panel-manager-row">
                                <div class="showcase-panel-manager-main">
                                    <span class="name">@current.Panel.Title</span>
                                    <span class="state">@StateLabel(current)</span>
                                </div>
                                <div class="showcase-panel-manager-row-actions">
                                    <button type="button"
                                            disabled="@(!current.Exists)"
                                            @onclick="() => ActivateAsync(current)"
                                            aria-label="打开 @current.Panel.Title">打开</button>
                                    <button type="button"
                                            disabled="@(!current.Exists)"
                                            @onclick="() => ToggleGroupAsync(current)">
                                        @(current.GroupVisible ? "折叠分组" : "展开分组")
                                    </button>
                                    @if (targets.Count > 0)
                                    {
                                        <select aria-label="移动 @current.Panel.Title 到区域"
                                                @onchange="args => MoveAsync(current, args.Value?.ToString())">
                                            <option value="">移动到…</option>
                                            @foreach (var target in targets)
                                            {
                                                <option value="@target.Id.Value">@target.Label</option>
                                            }
                                        </select>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                    <p class="showcase-panel-manager-note">
                        “折叠分组”影响该 Group 内的所有面板；切换布局会重置布局历史。
                        紧凑布局在加载时按视口选择；运行时调整窗口后请用此菜单手动切换。
                    </p>
                </section>
            }
        </div>
        <span class="showcase-branch">atlas/showcase</span>
    </div>
</header>

@code {
    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public bool CanRedo { get; set; }

    [Parameter]
    public IReadOnlyList<ShowcasePanelView> Panels { get; set; } = Array.Empty<ShowcasePanelView>();

    [Parameter]
    public IReadOnlyList<ShowcaseGroupDescriptor> Groups { get; set; } = Array.Empty<ShowcaseGroupDescriptor>();

    [Parameter]
    public bool IsCompact { get; set; }

    [Parameter]
    public bool ShowVerificationLink { get; set; } = true;

    [Parameter]
    public Func<ShowcasePanelDescriptor, Task> OnActivatePanel { get; set; } = static _ => Task.CompletedTask;

    [Parameter]
    public Func<ShowcasePanelView, Task> OnToggleGroup { get; set; } = static _ => Task.CompletedTask;

    [Parameter]
    public Func<ShowcasePanelDescriptor, LayoutNodeId, Task> OnMovePanel { get; set; } = static (_, _) => Task.CompletedTask;

    [Parameter]
    public Func<Task> OnReset { get; set; } = static () => Task.CompletedTask;

    [Parameter]
    public Func<Task> OnToggleCompact { get; set; } = static () => Task.CompletedTask;

    [Parameter]
    public EventCallback OnOpenGuide { get; set; }

    [Parameter]
    public EventCallback OnOpenCatalog { get; set; }

    [Parameter]
    public EventCallback OnOpenTheme { get; set; }

    [Parameter]
    public EventCallback OnOpenVerification { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public EventCallback OnRedo { get; set; }

    private bool PanelManagerOpen { get; set; }

    private bool focusManagerPending;

    private bool focusTriggerPending;

    private ElementReference menuButton;

    private ElementReference managerElement;

    private IReadOnlyList<ShowcaseGroupDescriptor> MoveTargets(ShowcasePanelView view)
    {
        return !view.Exists
            ? Array.Empty<ShowcaseGroupDescriptor>()
            : Groups.Where(group => group.Id != view.GroupId).ToArray();
    }

    private static string StateLabel(ShowcasePanelView view)
    {
        if (!view.Exists)
        {
            return "不存在";
        }

        if (!view.GroupVisible)
        {
            return "已折叠";
        }

        return view.IsSelected ? "当前显示" : "已展开";
    }

    private async Task TogglePanelManagerAsync()
    {
        if (PanelManagerOpen)
        {
            await ClosePanelManagerAsync();
            return;
        }

        PanelManagerOpen = true;
        focusManagerPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClosePanelManagerAsync()
    {
        if (!PanelManagerOpen)
        {
            return;
        }

        PanelManagerOpen = false;
        focusTriggerPending = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusManagerPending)
        {
            focusManagerPending = false;
            await FocusAsync(managerElement);
        }
        else if (focusTriggerPending)
        {
            focusTriggerPending = false;
            await FocusAsync(menuButton);
        }
    }

    private async Task ActivateAsync(ShowcasePanelView view)
    {
        await OnActivatePanel(view.Panel);
        await ClosePanelManagerAsync();
    }

    private async Task ToggleGroupAsync(ShowcasePanelView view)
    {
        await OnToggleGroup(view);
        await ClosePanelManagerAsync();
    }

    private async Task MoveAsync(ShowcasePanelView view, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        await OnMovePanel(view.Panel, new LayoutNodeId(value));
        await ClosePanelManagerAsync();
    }

    private async Task ResetAsync()
    {
        await OnReset();
        await ClosePanelManagerAsync();
    }

    private async Task ToggleCompactAsync()
    {
        await OnToggleCompact();
        await ClosePanelManagerAsync();
    }

    private async Task OnDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await ClosePanelManagerAsync();
        }
    }

    private static async Task FocusAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            // 静态渲染或元素尚未挂载时没有可聚焦的浏览器上下文。
        }
    }
}
