@namespace Atlas.Showcase.Components
@using Atlas.Blazor.Components
@using Atlas.Blazor.Content

<section class="showcase-shell" aria-label="Atlas 演示教学工作区">
    @{
        var panelViews = BuildPanelViews();
    }
    @if (initializationError is not null)
    {
        <div class="showcase-loading showcase-init-error" role="alert">
            <p>Atlas 演示初始化失败。</p>
            <code>@initializationError</code>
            <button type="button" class="showcase-action" @onclick="RetryAsync">重试</button>
        </div>
    }
    else if (workspace is null)
    {
        <div class="showcase-loading" role="status">正在准备 Atlas 演示…</div>
    }
    else
    {
        <AtlasWorkspaceHost @key="workspace"
                            Workspace="@workspace"
                            WorkspaceOwnership="WorkspaceOwnership.External"
                            EnableInteractions="true">
            <TopToolbarContent>
                <ShowcaseTopToolbar CanUndo="@workspace.CanUndo"
                                    CanRedo="@workspace.CanRedo"
                                    Panels="@panelViews"
                                    Groups="@MoveGroups"
                                    IsCompact="@isCompact"
                                    ShowVerificationLink="@ShowVerificationLink"
                                    OnActivatePanel="panel => OpenPanelAsync(panel)"
                                    OnToggleGroup="view => ToggleGroupAsync(view)"
                                    OnMovePanel="(panel, target) => MovePanelAsync(panel, target)"
                                    OnReset="() => ResetWorkspaceAsync()"
                                    OnToggleCompact="() => ToggleCompactAsync()"
                                    OnOpenGuide="() => OpenGuideAsync()"
                                    OnOpenCatalog="() => OpenCatalogAsync()"
                                    OnOpenTheme="() => OpenThemeAsync()"
                                    OnOpenVerification="() => OpenVerificationAsync()"
                                    OnUndo="() => UndoAsync()"
                                    OnRedo="() => RedoAsync()" />
            </TopToolbarContent>
            <StatusBarContent>
                <ShowcaseStatusBar OperationStatus="@operationStatus"
                                   Revision="@revision"
                                   Tone="@statusTone" />
            </StatusBarContent>
            <ContentRoutes>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Catalog">
                    <ChildContent Context="content">
                        <TeachingCatalogPanel Items="@panelViews" OnSelect="panel => OpenPanelAsync(panel)" />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Layout">
                    <ChildContent Context="content">
                        <LayoutPanel />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Content">
                    <ChildContent Context="content">
                        <ContentPanel />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.DragDrop">
                    <ChildContent Context="content">
                        <DragDropPanel />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Keyboard">
                    <ChildContent Context="content">
                        <KeyboardPanel />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Splitter">
                    <ChildContent Context="content">
                        <SplitterPanel />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Theme">
                    <ChildContent Context="content">
                        <ThemePanel />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Persistence">
                    <ChildContent Context="content">
                        <PersistencePanel CaptureLayout="CaptureLayoutAsync"
                                          RestoreLayout="RestoreLayoutAsync"
                                          LastEvent="@persistenceEvent" />
                    </ChildContent>
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@ShowcaseContentKinds.Guide">
                    <ChildContent Context="content">
                        <GuidePanel ResourceId="@content.Reference.ResourceId" />
                    </ChildContent>
                </AtlasContentRoute>
            </ContentRoutes>

            <ErrorTemplate Context="content">
                <div class="showcase-host-error">
                    内容渲染失败：<code>@content.Code</code>
                </div>
            </ErrorTemplate>
        </AtlasWorkspaceHost>
    }
</section>
