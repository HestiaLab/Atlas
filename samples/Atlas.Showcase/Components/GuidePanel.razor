@namespace Atlas.Showcase.Components

@if (ResourceId == ShowcaseDocuments.Shortcuts.ResourceId)
{
    <div class="showcase-editor showcase-guide">
        <div class="showcase-card">
            <div class="showcase-req-line">
                <span class="req">REQ-F-116 · REQ-F-117 · REQ-F-118</span>
            </div>
            <div class="showcase-card-body">
                <h2>快捷键速查</h2>
                <p>把焦点放在编辑器标签页或工作区内，再使用以下默认绑定。
                命令映射可以通过 <code>AtlasKeyboardCommandMap</code> 重新绑定。</p>
                <table class="showcase-table">
                    <thead>
                        <tr><th>快捷键</th><th>行为</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Ctrl+Tab</td><td>激活下一个编辑器标签页</td></tr>
                        <tr><td>Ctrl+Shift+Tab</td><td>激活上一个编辑器标签页</td></tr>
                        <tr><td>Ctrl+W / Ctrl+F4</td><td>关闭当前可关闭标签页</td></tr>
                        <tr><td>Alt+方向键</td><td>把焦点移到相邻面板</td></tr>
                        <tr><td>方向键（聚焦分割条）</td><td>按键盘步进调整分割尺寸</td></tr>
                    </tbody>
                </table>
                <p><span class="showcase-tag accent">试一试</span> 点击
                <strong>使用指南</strong> 或本标签页，按
                <span class="showcase-kbd">Ctrl</span>+<span class="showcase-kbd">Tab</span>
                切换；再按 <span class="showcase-kbd">Ctrl</span>+<span class="showcase-kbd">W</span>
                关闭本标签页。关闭后可从顶部 <strong>面板</strong> 菜单重置布局恢复。</p>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.KeyboardBinding</pre>
            </div>
        </div>
    </div>
}
else
{
    <div class="showcase-editor showcase-guide">
        <div class="showcase-card">
            <div class="showcase-req-line">
                <span class="req">REQ-F-001 · REQ-F-006 · REQ-F-099</span>
            </div>
            <div class="showcase-card-body">
                <h2>Atlas 快速上手</h2>
                <p><strong>Atlas</strong> 是面向 Blazor 的停靠布局组件库。
                本演示是真实可运行的示例：每个能力面板都演示一项 API，
                并给出可对照当前版本阅读的代码片段。</p>
                <h3>三步创建一个工作区</h3>
                <ol>
                    <li>引用 <code>Atlas.Blazor</code> NuGet 包。</li>
                    <li>注册服务：<code>builder.Services.AddAtlasWorkspace()</code>。</li>
                    <li>承载工作区并声明布局与内容。</li>
                </ol>
                <p><span class="showcase-tag accent">试一试</span>
                使用顶部导航栏的 <strong>面板</strong> 菜单折叠分组、移动面板或切换紧凑布局；
                拖动标签页进行停靠；拖动分割条调整大小。下面的章节逐项说明。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">1. 引用包与注册服务</div>
            <div class="showcase-card-body">
                <p>在项目中添加 <code>Atlas.Blazor</code> 包引用，并在
                <code>Program.cs</code> 中注册 Atlas 服务：</p>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.Install</pre>
                <p>包内嵌 <code>Atlas.Core</code>（ADR-0019），你只需要这一个包。
                框架提供的 DI 服务包括工作区工厂、历史与持久化支持。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">2. 声明布局</div>
            <div class="showcase-card-body">
                <p>布局由 Split（分割）、Group（分组）和 Item（面板/标签页）
                三层结构组成。有两种声明方式：</p>
                <h3>声明式（Razor 组件）</h3>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.DeclarativeLayout</pre>
                <p>可编译、可运行的版本：<a href="declarative">声明式示例页</a>。</p>
                <h3>程序式（C# 定义）</h3>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.CreateWorkspace</pre>
                <p>本演示的工作区用程序式 API 构建（见
                <code>ShowcaseWorkspaceDefinition.cs</code>），以便顶部快捷面板
                能直接访问工作区句柄；两种方式产生相同的结构。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">3. 注册内容</div>
            <div class="showcase-card-body">
                <p>面板和标签页按 <em>Kind</em> 渲染组件。生效的 Content Catalog
                合并三处来源：</p>
                <ul>
                    <li>启动时 DI 注册：<code>AddAtlasContent&lt;TComponent&gt;(kind)</code></li>
                    <li>Host 内 <code>AtlasContentRoute</code> 声明</li>
                    <li>函数式内容映射</li>
                </ul>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.ContentRoute</pre>
                <p>Kind 字符串必须与布局定义中的 <code>ContentKind</code> 一致；
                不一致会得到「Content is not registered」运行时错误。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">4. 交互操作</div>
            <div class="showcase-card-body">
                <p>框架开箱即用：<code>EnableInteractions="true"</code> 时，
                <code>AtlasWorkspaceHost</code> 自动接线拖拽、停靠、分割与
                键盘命令。指针交互无需配置：</p>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.Interaction</pre>
                <p>键盘默认绑定（可自定义命令映射）：</p>
                <ul>
                    <li><span class="showcase-kbd">Ctrl</span>+<span class="showcase-kbd">Tab</span>
                    切换编辑器标签页</li>
                    <li><span class="showcase-kbd">Ctrl</span>+<span class="showcase-kbd">W</span>
                    关闭当前可关闭标签页</li>
                    <li><span class="showcase-kbd">Alt</span>+方向键切换面板焦点</li>
                    <li>方向键调整已聚焦分割条的大小</li>
                </ul>
                <p>所有交互最终提交为 Core 操作（如
                <code>SetGroupVisibilityOperation</code>、
                <code>MoveToolOperation</code>、<code>DockDocumentOperation</code>），
                进入历史栈，可撤销/重做。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">5. 主题定制</div>
            <div class="showcase-card-body">
                <p>Atlas 通过文档化的 <code>--atlas-*</code> CSS 变量
                （ADR-0023）暴露视觉样式。在 <code>atlas.css</code> 之后加载
                自己的样式表并覆盖变量即可，无需 <code>!important</code>，
                也不需要 Atlas 内部选择器；边框、圆角等效果层仍由消费方样式负责：</p>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.Theme</pre>
                <p>明暗主题：设置 <code>color-scheme</code> 后，系统颜色跟随
                操作系统偏好自动切换。本演示在 <code>app.css</code> 中用
                <code>--showcase-*</code> 调色板驱动每个 Atlas token。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">6. 持久化</div>
            <div class="showcase-card-body">
                <p>布局快照可序列化为版本化 XML（V2 schema），并可原子恢复。
                更高层的 <code>LayoutPresetService</code> 与
                <code>LayoutAutoPersistence</code> 负责具名快照和防抖自动保存：</p>
                <pre class="showcase-code" tabindex="0">@ShowcaseSnippets.Persistence</pre>
                <p>可在「持久化」面板实际试一试：拖动面板后点
                <strong>捕获</strong>，再点 <strong>恢复</strong>。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">7. 常见问题</div>
            <div class="showcase-card-body">
                <dl class="showcase-faq">
                    <dt>声明式还是程序式？</dt>
                    <dd>布局在 Razor 中固定时用声明式；需要动态创建、或要
                    直接调用工作区操作（如本演示的快捷菜单）时用程序式。</dd>
                    <dt>面板显示「Content is not registered」？</dt>
                    <dd>Kind 字符串不匹配。检查布局里的
                    <code>ContentKind</code> 与注册的 kind 是否完全一致。</dd>
                    <dt>需要多个独立工作区？</dt>
                    <dd>每个 <code>AtlasWorkspaceHost</code> 拥有独立的工作区
                    与历史。访问 <a href="verification">双 Host 验证页</a> 查看演示。</dd>
                    <dt>如何修改键盘绑定？</dt>
                    <dd>构造 <code>AtlasKeyboardCommandMap(bindings)</code> 传给
                    Host 的 <code>KeyboardCommands</code> 参数。</dd>
                    <dt>窄屏或 200% 缩放？</dt>
                    <dd>顶部 <strong>面板</strong> 菜单可切换紧凑布局；
                    验证页会自动使用紧凑布局。紧凑布局在页面加载时按视口选择，
                    运行时调整窗口后请手动切换。</dd>
                </dl>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-card-title">能力索引</div>
            <div class="showcase-card-body">
                <table class="showcase-table">
                    <thead>
                        <tr><th>面板</th><th>教学内容</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>教学目录</td><td>面板导航</td></tr>
                        <tr><td>声明式布局</td><td>Razor 布局声明</td></tr>
                        <tr><td>内容注册</td><td>按 Kind 的内容目录</td></tr>
                        <tr><td>拖拽与停靠</td><td>指针拖拽、停靠区域</td></tr>
                        <tr><td>分割条</td><td>调整大小、约束、等分</td></tr>
                        <tr><td>键盘操作</td><td>快捷键与命令映射</td></tr>
                        <tr><td>主题定制</td><td>CSS 变量契约</td></tr>
                        <tr><td>持久化</td><td>XML 捕获与恢复</td></tr>
                        <tr><td>快捷键速查</td><td>默认键盘命令与文档切换</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string ResourceId { get; set; } = ShowcaseDocuments.Guide.ResourceId;
}
