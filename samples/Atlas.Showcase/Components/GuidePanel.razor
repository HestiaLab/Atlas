@namespace Atlas.Showcase.Components

<div class="showcase-editor">
    <div class="showcase-card">
        <div class="showcase-card-title">
            Quick Start
            <span class="req">REQ-F-099 · REQ-F-101</span>
        </div>
        <div class="showcase-card-body">
            <p><strong>Atlas</strong> is a dock layout component library for
            Blazor. This showcase is a live, runnable example: every panel
            demonstrates one capability, and every panel can show the real API
            code behind it.</p>
            <h3 style="margin:0.5rem 0 0.25rem">Three steps to a workspace</h3>
            <ol style="margin:0;padding-inline-start:1.25rem">
                <li>Reference the <code>Atlas.Blazor</code> NuGet package.</li>
                <li>Register services: <code>builder.Services.AddAtlasWorkspace()</code>.</li>
                <li>Host the workspace and declare your layout + content.</li>
            </ol>
            <p style="margin-top:0.5rem"><span class="showcase-tag accent">Try it</span>
            use the <strong>Panels</strong> menu in the top bar to hide, show,
            or move any panel; drag tabs to dock them; drag splitters to
            resize.</p>
        </div>
    </div>
    <div class="showcase-card">
        <div class="showcase-card-title">
            Capability Index
        </div>
        <div class="showcase-card-body">
            <table class="showcase-table">
                <thead>
                    <tr><th>Panel</th><th>What it teaches</th></tr>
                </thead>
                <tbody>
                    <tr><td>Teaching Catalog</td><td>Panel navigation</td></tr>
                    <tr><td>Declarative Layout</td><td>Razor layout declarations</td></tr>
                    <tr><td>Content Registration</td><td>Content Catalog by Kind</td></tr>
                    <tr><td>Drag &amp; Dock</td><td>Pointer drag, dock zones</td></tr>
                    <tr><td>Splitter</td><td>Resize, constraints, equalize</td></tr>
                    <tr><td>Keyboard</td><td>Shortcuts and command maps</td></tr>
                    <tr><td>Theming</td><td>CSS variable contract</td></tr>
                    <tr><td>Persistence</td><td>XML capture and restore</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
