@namespace Atlas.Showcase.Components
@using Atlas.Core.Persistence

<div class="showcase-tool">
    <TeachingCard Title="持久化"
                  Requirement="REQ-F-085 · REQ-F-086"
                  CodeSnippet="@Code">
        <p>Atlas 将已提交的布局序列化为带版本的 XML 文档（V2 schema），
        并可原子地恢复它。预设是具名布局快照；自动持久化会为你
        防抖保存。</p>
        <p><span class="showcase-tag accent">试一试</span> 拖动面板或标签页，
        然后点击 <button class="showcase-action" type="button" @onclick="Capture">捕获</button>
        快照当前布局。用
        <button class="showcase-action" type="button" @onclick="Restore">恢复</button>
        还原。</p>
        @if (LastEvent is not null)
        {
            <p><span class="showcase-tag ok">@LastEvent</span></p>
        }
    </TeachingCard>
</div>

@code {
    private const string Code = @"// 将已提交的快照序列化为 V2 XML
var serializer = new AtlasXmlLayoutSerializer();
string xml = serializer.Serialize(workspace.Current);

// 原子恢复（经过验证的候选，历史屏障）
var doc = serializer.Deserialize(xml, workspace.Id).Value;
await workspace.ExecuteAsync(new RestoreWorkspaceOperation(doc));";

    private string? lastXml;

    [Parameter]
    public Func<Task<string?>>? CaptureLayout { get; set; }

    [Parameter]
    public Func<string, Task>? RestoreLayout { get; set; }

    [Parameter]
    public string? LastEvent { get; set; }

    private async Task Capture()
    {
        if (CaptureLayout is null)
        {
            return;
        }

        lastXml = await CaptureLayout();
        if (LastEvent is not null)
        {
            LastEvent = "布局已捕获";
        }
    }

    private async Task Restore()
    {
        if (RestoreLayout is null || lastXml is null)
        {
            return;
        }

        await RestoreLayout(lastXml);
        LastEvent = "布局已恢复";
    }
}
