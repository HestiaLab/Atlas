@namespace Atlas.Showcase.Components

<div class="showcase-tool" role="navigation" aria-label="教学目录">
    <ul class="showcase-list">
        @foreach (var view in Items)
        {
            var current = view;
            <li>
                <button type="button"
                        class="showcase-list-button"
                        @onclick="() => OnSelect(current.Panel)"
                        aria-label="打开 @current.Panel.Title 面板">
                    <span class="idx">@current.Panel.Index</span>
                    <span class="title">@current.Panel.Title</span>
                    <span class="state">@StateLabel(current)</span>
                </button>
            </li>
        }
    </ul>
    <div class="showcase-card-body">
        <p>下面的每个面板演示 Atlas 的一项能力。点击某行打开对应面板；
        使用顶部导航栏的 <strong>面板</strong> 菜单折叠分组或移动面板。</p>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ShowcasePanelView> Items { get; set; } = Array.Empty<ShowcasePanelView>();

    [Parameter]
    public Func<ShowcasePanelDescriptor, Task> OnSelect { get; set; } = static _ => Task.CompletedTask;

    private static string StateLabel(ShowcasePanelView view)
    {
        if (!view.Exists)
        {
            return "不存在";
        }

        if (!view.GroupVisible)
        {
            return "已折叠";
        }

        return view.IsSelected ? "当前显示" : "已展开";
    }
}
