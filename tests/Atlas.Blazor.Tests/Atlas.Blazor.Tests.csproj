<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source-level references: tests exercise both projects directly. The
         single-package distribution (ADR-0019) only affects NuGet packaging;
         PrivateAssets=all on Atlas.Blazor's Core reference would otherwise
         hide Atlas.Core from this test project, so reference it explicitly. -->
    <ProjectReference Include="..\..\src\Atlas.Core\Atlas.Core.csproj" />
    <ProjectReference Include="..\..\src\Atlas.Blazor\Atlas.Blazor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\interaction-protocol-v1.json"
          Link="fixtures\interaction-protocol-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\sandbox-protocol-v1.json"
          Link="fixtures\sandbox-protocol-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Atlas.Blazor\ClientScripts\dom-metadata-manifest.json"
          Link="fixtures\dom-metadata-manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Atlas.Blazor\wwwroot\atlas-v2\atlas.css"
          Link="fixtures\atlas.css"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Atlas.Blazor\wwwroot\atlas-v2\themes\ide.css"
          Link="fixtures\ide.css"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\zh\theming.md"
          Link="fixtures\theming.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
